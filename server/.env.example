# Copy this file to .env and fill it in. Never commit .env.

PORT=3001

# Where inquiries are delivered
INQUIRY_TO=hritiknagpal07@gmail.com

# Gmail account that sends the email (can be the same address).
# SMTP_PASS must be a Gmail "App password", not your normal password:
# Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hritiknagpal07@gmail.com
SMTP_PASS=your-16-character-app-password

# Origins allowed to call the API (comma separated). Production site URL goes here too.
ALLOWED_ORIGINS=http://localhost:5173

# true = log emails to the console instead of sending (for testing)
DRY_RUN=false
